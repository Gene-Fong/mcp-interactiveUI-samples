# HubSpot CRM — Environment Variables
# Copy this file to .env and fill in your values.

# Required: HubSpot Private App access token
HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server port (default: 8082)
PORT=8082

# CORS origins (comma-separated, default: *)
CORS_ORIGINS=*

# Transport: http (streamable HTTP, default) or stdio (local MCP clients)
MCP_TRANSPORT=http

# Dual mode:
#   auto  - widget payload plus a full markdown rendering in the text content,
#           so UI hosts and plain MCP clients both work (default)
#   ui    - widget only, original behaviour (requires web/widget.html)
#   plain - conventional text-only MCP server; no widget resource is registered
MCP_UI_MODE=auto

# Max table rows rendered in plain mode (default: 25)
PLAIN_MAX_ROWS=25

# Optional: Azure Application Insights connection string for telemetry
APPINSIGHTS_CONNECTION_STRING=
